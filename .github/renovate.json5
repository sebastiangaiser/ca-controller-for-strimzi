{
  commitBody: 'Signed-off-by: Sebastian Gaiser <sebastiangaiser@users.noreply.github.com>',
  enabled: true,
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  labels: [
    'renovate',
  ],
  extends: [
    'config:recommended',
  ],
  'pre-commit': {
    enabled: true,
  },
  postUpdateOptions: [
    'gomodTidy',
  ],
  // Renovate's default ignorePaths contains `**/examples/**`, which would hide
  // examples/kafka.yaml from the custom manager below. Keep the other defaults.
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/__tests__/**',
    '**/test/**',
    '**/tests/**',
    '**/__fixtures__/**',
  ],
  // Track the Kafka version + metadataVersion from Strimzi's authoritative
  // kafka-versions.yaml (the entry marked `default: true`).
  //
  // The URL is pinned to a released Strimzi tag (NOT main, which contains
  // Kafka versions that are not yet shipped in any Strimzi release). The tag
  // itself is kept up to date by the second custom manager below, which bumps
  // it via the github-releases datasource.
  customDatasources: {
    'strimzi-kafka': {
      // renovate: datasource=github-releases depName=strimzi/strimzi-kafka-operator
      defaultRegistryUrlTemplate: 'https://raw.githubusercontent.com/strimzi/strimzi-kafka-operator/1.2.0/kafka-versions.yaml',
      format: 'yaml',
      transformTemplates: [
        '{ "releases": [ { "version": $string($[default=true].version) } ] }',
      ],
    },
    'strimzi-kafka-metadata': {
      // renovate: datasource=github-releases depName=strimzi/strimzi-kafka-operator
      defaultRegistryUrlTemplate: 'https://raw.githubusercontent.com/strimzi/strimzi-kafka-operator/1.2.0/kafka-versions.yaml',
      format: 'yaml',
      transformTemplates: [
        '{ "releases": [ { "version": $string($[default=true].metadata) } ] }',
      ],
    },
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['examples/kafka.yaml'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+:\\s*(?<currentValue>\\S+)',
      ],
    },
    // Keep the pinned Strimzi release tag in the datasource URLs above up to
    // date, so we read kafka-versions.yaml from the latest *released* Strimzi.
    {
      customType: 'regex',
      managerFilePatterns: ['.github/renovate.json5'],
      matchStrings: [
        '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+defaultRegistryUrlTemplate:.*/strimzi-kafka-operator/(?<currentValue>[^/]+)/',
      ],
    },
  ],
  packageRules: [
    // Update version + metadataVersion together in a single PR.
    {
      matchDatasources: ['custom.strimzi-kafka', 'custom.strimzi-kafka-metadata'],
      groupName: 'strimzi kafka version',
    },
    // metadataVersion looks like `4.3-IV0`, which is not semver.
    {
      matchDatasources: ['custom.strimzi-kafka-metadata'],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-IV(?<patch>\\d+)$',
    },
    {
      matchManagers: ['github-actions'],
      automerge: true,
    },
    {
      matchPackageNames: [
        'golang',
        'k8s.io/api',
        'k8s.io/apimachinery',
        'k8s.io/client-go',
        'github.com/onsi/ginkgo/v2',
        'sigs.k8s.io/controller-runtime',
        'go.uber.org/zap',
      ],
      automerge: true,
    },
  ],
  rebaseWhen: 'conflicted',
  semanticCommits: 'enabled',
  timezone: 'Europe/Berlin',
}
